---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Blog | Thoughts & Stories">
  <div class="max-w-4xl mx-auto py-20 text-center">
    <div class="inline-block p-4 rounded-full bg-blue-50 dark:bg-blue-900/30 mb-6 text-blue-500 dark:text-blue-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
    </div>
    <h1 class="text-4xl font-bold mb-4 text-gray-900 dark:text-white">Blog</h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 mb-8">
      Articles and tutorials are coming soon. Stay tuned!
    </p>
    
    <div class="h-64 w-full rounded-2xl bg-gray-200 dark:bg-gray-800 animate-pulse flex items-center justify-center text-gray-400 dark:text-gray-600">
        <span>Content Loading...</span>
    </div>
  </div>
</Layout>
