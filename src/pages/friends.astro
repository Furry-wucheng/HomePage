---
import Layout from '../layouts/Layout.astro';
import FriendList from '../components/FriendList.svelte';
import { friendLinks, siteConfig } from '../config';

const codeSnippet = `name: 戊成的主页
link: https://wucheng.work
description: 怀念过去，珍惜现在，着手未来。
avatar: https://q1.qlogo.cn/g?b=qq&nk=3241748701&s=640
`;
---

<Layout title={`友链 | ${siteConfig.title}`} description="查看我的友链列表。">
  <!-- 装饰背景层 - 为 backdrop-blur 提供可模糊的内容 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none opacity-30">
    <div class="absolute top-20 left-10 w-96 h-96 bg-purple-500/20 rounded-full blur-3xl"></div>
    <div class="absolute top-60 right-20 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-40 left-1/3 w-72 h-72 bg-pink-500/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 right-1/4 w-64 h-64 bg-cyan-500/20 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-5xl mx-auto py-12 animate-slide-up relative">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900 dark:text-white">友链</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        
      </p>
    </div>

    <FriendList client:visible groups={friendLinks} />
    
    <div class="mt-20 p-8 rounded-2xl bg-linear-to-r from-blue-500/10 to-purple-500/10 border border-blue-500/20 text-center">
        <h3 class="text-xl font-semibold mb-2 text-gray-800 dark:text-gray-100">如何加入友链</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
        请通过社交媒体与我联系，发送您的网站信息和简短介绍。或者发送邮件到<a href="mailto:2538000780@qq.com" class="text-blue-500 hover:text-blue-700">这里</a>
        </p>
        <pre class="md-code-block"><code>{codeSnippet}</code></pre>
        <!-- <a href="mailto:2538000780@qq.com" class="inline-block px-6 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white transition-colors font-medium">
            Contact Me
        </a> -->
    </div>
  </div>
</Layout>

<style>
    .animate-slide-up {
        animation: slideUp 0.8s ease-out forwards;
    }

  .md-code-block {
    margin: 0 auto;
    width: 100%;
    max-width: 42rem;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #0b1220;
    color: #e5e7eb;
    text-align: left;
    font-family: "Fira Code", "Cascadia Code", Consolas, "Courier New", monospace;
    font-size: 0.95rem;
    line-height: 1.7;
    white-space: pre;
    overflow-wrap: normal;
    word-break: normal;
    overflow-x: auto;
  }

  .md-code-block code {
    display: inline-block;
    min-width: max-content;
  }

    @keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
